[TXT]
RegPai = DOCS
Reg = DOCS
Dipslay = 
SubPasta = sim
Caminho = SPED\SPED_FISCAL\
Salvar = NAO
Gerar = NAO
SHOWSQL = NAO

[SQL]
1=SELECT "DOCS" REG, SUBSTRING(ESTAB.CNPJCPF_ESTB FROM 1 FOR 8) RAIZ_CNPJ, DOC.COD_ESTAB, DOC.CNPJCPF_PESS CNPJ_CPF_PART, DOC.COD_DOC, CASE WHEN DOC.MOV_DOC = "E" THEN 0 ELSE 1 END IND_OPER, CASE WHEN (DOC.COD_AIDF > 0) OR (DOC.MOV_DOC = "S") THEN 0 ELSE 1 END IND_EMIT,
2=CASE WHEN (DOC.CANC_DOC = "S" OR DOC.COD_MOD = "65" OR DOC.STATUS_DOC = "I") THEN NULL ELSE CASE WHEN DOC.COD_MOD = "57" AND DOC.COD_AIDF > 0 THEN DOC.CODF_PESS ELSE DOC.COD_PESS END END COD_PART, RIGHT('00' || DOC.COD_MOD,2)  COD_MOD,
3=CASE WHEN DOC.FINNFE_DOC = "2" AND DOC.PRINT_DOC = "S" AND DOC.CANC_DOC = "N" THEN "06" 
4=     WHEN DOC.TIPO_DOC = "E" THEN "01" 
5=     WHEN DOC.CANC_DOC = "S" AND DOC.STATUS_DOC = "C" THEN "02" 
6=     WHEN DOC.TIPO_DOC = "E" AND DOC.CANC_DOC = "S" THEN "03" 
7=     WHEN DOC.TIPO_DOC = "E" AND DOC.FINNFE_DOC = "2" THEN "01"
8=     WHEN DOC.STATUS_DOC = "I" THEN "05" WHEN DOC.STATUS_DOC = "D" THEN "04"
9=     ELSE    "00" 
10=END COD_SIT,
11=COALESCE(SUBSTRING(CHAVENFE_DOC FROM 23 FOR 3), RIGHT("000" || DOC.SERIE_DOC,3)) SER, "" SUB,
12=DOC.NUM_DOC,CASE WHEN DOC.STATUS_DOC = "I" THEN NULL ELSE DOC.CHAVENFE_DOC END CHV_NFE, CASE WHEN (DOC.CANC_DOC = "S"  OR DOC.STATUS_DOC = "I") THEN NULL ELSE CAST(CAST(DOC.EMISS_DOC AS VARCHAR(11) )  AS DATE )  END DT_DOC, DOC.EMISS_DOC DT_CANC_DOC, CASE WHEN (DOC.CANC_DOC = "S" OR DOC.STATUS_DOC = "I") THEN NULL ELSE CAST(CAST(DOC.ENTSAID_DOC AS VARCHAR(11) )  AS DATE ) END DT_E_S, CASE WHEN (DOC.CANC_DOC = "S" OR DOC.STATUS_DOC = "I") THEN NULL ELSE COALESCE(DOC.TOTALG_DOC,0.01) END VL_DOC,
13=CASE WHEN (DOC.CANC_DOC = "S" OR DOC.STATUS_DOC = "I") THEN "" ELSE CASE WHEN DOC.TOTFIN_DOC = 0 THEN "2" WHEN DOC.CPAGTO_DOC = "AV" THEN "0" WHEN DOC.CPAGTO_DOC = "AP" THEN "1" ELSE  "2" END END IND_PGTO, 
14=CASE WHEN (DOC.CANC_DOC = "S" OR DOC.STATUS_DOC = "I") THEN NULL ELSE COALESCE(DOC.VRDESC_DOC,0) END VL_DESC, 0.0 VL_ABAT_NT, 
15=CASE WHEN (DOC.CANC_DOC = "S" OR DOC.STATUS_DOC = "I") THEN NULL ELSE COALESCE(DOC.TOTPRODBR_DOC,0) + COALESCE(DOC.SERVISS_DOC,0) + COALESCE(DOC.ICMSR_DOC,0) + 
16=COALESCE(DOC.IPI_DOC,0) - CASE WHEN COALESCE(ESTAB.ATIV2_ESTB,'0') <> '0' THEN 0.0 ELSE COALESCE(DOC.IPIE_DOC,0) END END VL_MERC,
17=CASE WHEN (DOC.CANC_DOC = 'S' OR DOC.STATUS_DOC = 'I') THEN NULL ELSE CASE WHEN DOC.COD_MOD = '57' then IIF(COALESCE(DOC.MODFRETE_DOC,'9') IN ('3', '4') ,'9',COALESCE(DOC.MODFRETE_DOC,'9')) ELSE COALESCE(DOC.MODFRETE_DOC,'9') END END IND_FRT,
18=CASE WHEN (DOC.CANC_DOC = "S" OR DOC.STATUS_DOC = "I") THEN NULL ELSE COALESCE(DOC.FRETE_DOC,0) END VL_FRT, 
19=CASE WHEN (DOC.CANC_DOC = "S" OR DOC.STATUS_DOC = "I") THEN NULL ELSE COALESCE(DOC.SEGURO_DOC,0) END VL_SEG, 
20=CASE WHEN (DOC.CANC_DOC = "S" OR DOC.STATUS_DOC = "I") THEN NULL ELSE COALESCE(DOC.OUTDESP_DOC,0) END VL_OUT_DA, 
21=CASE WHEN DOC.CANC_DOC = "S" AND DOC.COD_MOD <> "57" THEN 0 WHEN (DOC.CANC_DOC = "S" OR DOC.STATUS_DOC = "I") AND DOC.COD_MOD = "57" THEN NULL ELSE COALESCE(DOC.BCICMSE_DOC,0) END VL_BC_ICMS,
22=CASE WHEN DOC.CANC_DOC = "S" AND DOC.COD_MOD <> "57" THEN 0 WHEN (DOC.CANC_DOC = "S" OR DOC.STATUS_DOC = "I") AND DOC.COD_MOD = "57" THEN NULL ELSE COALESCE(DOC.ICMSE_DOC,0) END VL_ICMS, 
23=CASE WHEN (DOC.CANC_DOC = "S" OR DOC.STATUS_DOC = "I") THEN 0 ELSE CASE WHEN COALESCE(DOC.ICMSRE_DOC,0) = 0 THEN 0 ELSE COALESCE(DOC.BCICMSRE_DOC, 0) END END VL_BC_ICMS_ST, 
24=CASE WHEN (DOC.CANC_DOC = "S" OR DOC.STATUS_DOC = "I") THEN 0 ELSE COALESCE(DOC.ICMSRE_DOC,0) END VL_ICMS_ST, 
25=DOC.BCIPIE_DOC VL_BC_IPI, CASE WHEN (DOC.CANC_DOC = "S" OR DOC.STATUS_DOC = "I") THEN 0 ELSE CASE WHEN COALESCE(ESTAB.ATIV2_ESTB,'0') <> '0' THEN NULL ELSE COALESCE(DOC.IPIE_DOC,0) END END VL_IPI,
26=CASE WHEN (DOC.CANC_DOC = "S" OR DOC.STATUS_DOC = "I") THEN 0 ELSE COALESCE(DOC.PISE_DOC,0) END VL_PIS,
27=CASE WHEN DOC.CANC_DOC = "S" THEN 0 ELSE COALESCE(DOC.COFINSE_DOC,0) END VL_COFINS, DOC.CANC_DOC, "" COD_INF, SUBSTRING(CASE WHEN DOC.COD_MOD = "57" AND DOC.CANC_DOC = "N" AND DOC.STATUS_DOC <> "I" THEN FINNFE_DOC - IIF(DOC.COD_AIDF = 0, 1, 0) ELSE "" END FROM 1 FOR 1) TP_CT_E, "" CHV_CTE_REF, 
28=CASE WHEN (DOC.CANC_DOC = "S" OR DOC.STATUS_DOC = "I") THEN NULL ELSE DOC.TOTALG_DOC END VL_SERV, CASE WHEN (DOC.CANC_DOC = "S" OR DOC.STATUS_DOC  = "I") THEN NULL ELSE 0 END VL_NT, DOC.MOV_DOC MOV, CASE WHEN DOC.MOV_DOC = "E" THEN 2 ELSE 1 END IND_NAT, MOD.ESP_MOD MOD, DOC.OUTRF_DOC VL_FCP_UF_DEST,
29=CASE WHEN DOC.UF_PESS = ESTAB.UF_ESTB AND DOC.MOV_DOC = "E" THEN 0.0 ELSE DOC.DALIQICMSD_DOC END VL_ICMS_UF_DEST, DOC.DALIQICMS_DOC DIFAL,  
30=CASE WHEN DOC.UF_PESS = ESTAB.UF_ESTB AND DOC.MOV_DOC = "E" THEN DOC.DALIQICMS_DOC ELSE DOC.DALIQICMS_DOC - DOC.DALIQICMSD_DOC END VL_ICMS_UF_REM, ESTAB.UF_ESTB UF_ESTB, DOC.CONTBICMS_PESS, DOC.CLTRIB3_DOC, 
31=IIF(DOC.CANC_DOC = 'S', NULL, IIF(DOC.COD_AIDF = 0, COALESCE(DOC.CODI_MUN, MUN.CODIBGE_MUN), MUN.CODIBGE_MUN)) COD_MUN_ORIG, 
32=IIF(DOC.CANC_DOC = 'S', NULL, IIF(DOC.COD_AIDF = 0, COALESCE(DOC.CODF_MUN, MUN2.CODIBGE_MUN), MUN2.CODIBGE_MUN)) COD_MUN_DEST,
33=DOC.CFOPS_DOC CFOP, DOC.UF_PESS, DOC.ICMSA_DOC VL_ICMSSN, DOC.ISENTO_DOC ISENTO_ICMS, DOC.OUTROS_DOC OUTROS_ICMS, DOC.ISEIPI_DOC ISENTO_IPI, DOC.OUTIPI_DOC OUTROS_IPI FROM DOC 
34=INNER JOIN ESTAB ON (ESTAB.COD_ESTAB = DOC.COD_ESTAB) 
35=LEFT JOIN MOD ON (MOD.COD_MOD = DOC.COD_MOD) 
36=LEFT JOIN MUN ON COALESCE(DOC.CODI_MUN,DOC.COD_MUN) = MUN.COD_MUN
37=LEFT JOIN MUN MUN2 ON COALESCE(DOC.CODF_MUN,ESTAB.COD_MUN) = MUN2.COD_MUN
40=WHERE DOC.COD_ESTAB = :COD_ESTAB AND 
41=     ( 
42=	  (DOC.EMISS_DOC >= :Data_Inicial || " 00:00:00" AND DOC.EMISS_DOC <= :Data_Final || " 23:59:59" AND DOC.MOV_DOC = "S") OR 
43=	  (DOC.ENTSAID_DOC >= :Data_Inicial || " 00:00:00" AND DOC.ENTSAID_DOC <= :Data_Final || " 23:59:59" AND DOC.MOV_DOC = "E") 
44=     ) 
45=AND ((DOC.COD_AIDF = 0 AND COALESCE(DOC.CANC_DOC, 'N') = 'N') OR DOC.COD_AIDF > 0) AND COALESCE(MOD.ESP_MOD,"NF") IN ("NF", "CT") AND DOC.COD_MOD IN ("1","1B","2","04","4","6","8","21","22","29","55","57","65","67") AND DOC.CFOPS_DOC <> '5999' AND DOC.CFOPS_DOC <> '6999'
46=EOF

[DISPLAYFORMAT]
DT_DOC = ddmmyyyy
DT_E_S = ddmmyyyy
VL_DOC = 0.00
VL_DESC = 0.00
VL_ABAT_NT = 0.00
VL_MERC = 0.00
VL_FRT = 0.00
VL_SEG = 0.00
VL_OUT_DA = 0.00
VL_BC_ICMS = 0.00
VL_ICMS = 0.00
VL_BC_ICMS_ST = 0.00
VL_ICMS_ST = 0.00
VL_IPI = 0.00
VL_PIS = 0.00
VL_COFINS = 0.00
TP_CT_E = 0

[ROTULO]

[FIELDSLENGTH]


[ChildNodes]
